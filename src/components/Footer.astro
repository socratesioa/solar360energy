---

---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__header">
      <img
        src="/icons/logo.svg"
        width="105"
        height="35"
        alt="Solar360 Energy Logo"
      />
      <ul class="social">
        <li><img src="/icons/icon-facebook.svg" width="40" height="40" /></li>
        <li><img src="/icons/icon-instagram.svg" width="40" height="40" /></li>
      </ul>
    </div>
    <div class="footer__contact">
      <div class="footer__contact-phone">
        <img src="/icons/icon-phone.svg" width="32" height="32" />
        <span>+357 70 070705</span>
      </div>
      <div class="footer__contact-hours">
        <img src="/icons/icon-clock.svg" width="32" height="32" />
        <span>7am - 6pm</span>
      </div>
    </div>
    <nav class="legal">
      <ul>
        <li><a href="/cookie-policy">Cookie Policy</a></li>
        <li><a href="/privacy-policy">Privacy Policy</a></li>
        <li><a href="/terms-of-service">Terms of Service</a></li>
      </ul>
    </nav>
  </div>

  <p class="footer__copyright">
    Copyright © {new Date().getFullYear()} Solar360 Energy.
    <span>All rights reserved.</span>
  </p>
</footer>
