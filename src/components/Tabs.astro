---
const features = [
  {
    id: "tab1",
    title: "Installations",
    text: "We design and install high-performance solar energy systems tailored to your property and energy needs. Our experienced team helps homes and businesses across Cyprus reduce electricity costs and achieve long-term energy savings.",
    href: "/installations",
    images: {
      desktop: ["/images/installations.jpg", "/images/installations.png"],
      tablet: ["/images/installations.jpg", "/images/installations.png"],
      mobile: ["/images/installations.jpg", "/images/installations.png"],
    },
    alt: "A fresh solar panel system installation",
  },
  {
    id: "tab2",
    title: "Panel Cleaning",
    text: "Dirty solar panels can reduce efficiency and lower energy output over time. Our professional cleaning service safely removes dust, dirt, and debris to help your system perform at its best all year round.",
    href: "/cleaning",
    images: {
      desktop: ["/images/cleaning.jpg", "/images/cleaning.png"],
      tablet: ["/images/cleaning.jpg", "/images/cleaning.png"],
      mobile: ["/images/cleaning.jpg", "/images/cleaning.png"],
    },
    alt: "Cleaned solar panels",
  },
  {
    id: "tab3",
    title: "Bird Proofing",
    text: "Birds nesting beneath solar panels can cause damage, mess, and costly repairs. Our durable bird proofing solutions protect your system while maintaining proper airflow and preserving the appearance of your installation.",
    href: "/bird-proofing",
    images: {
      desktop: ["/images/bird-proofing.jpg", "/images/bird-proofing.png"],
      tablet: ["/images/bird-proofing.jpg", "/images/bird-proofing.png"],
      mobile: ["/images/bird-proofing.jpg", "/images/bird-proofing.png"],
    },
    alt: "Solar panel bird proofing",
  },
];
---

<div class="section__tabs-container">
  <div class="tabs" role="tablist">
  {
    features.map((feature, index) => (
      <button
        class="feature-btn"
        role="tab"
        aria-selected={index === 0 ? "true" : "false"}
        data-tab={feature.id}
      >
        {feature.title}
      </button>
    ))
  }
</div>

<div class="feature-panels">
  {features.map((feature, index) => (
    <div
      class="feature-panel"
      data-panel={feature.id}
      hidden={index !== 0}
    >
      <picture class="feature-img-wrapper">
        
        <!-- Desktop -->
        <source
          srcset={`${feature.images.desktop[0]} 1x, ${feature.images.desktop[1]} 2x`}
          media="(min-width: 1200px)"
        />

        <!-- Tablet -->
        <source
          srcset={`${feature.images.tablet[0]} 1x, ${feature.images.tablet[1]} 2x`}
          media="(min-width: 768px)"
        />

        <!-- Fallback (mobile) -->
        <img
          src={feature.images.mobile[0]}
          srcset={`${feature.images.mobile[0]} 1x, ${feature.images.mobile[1]} 2x`}
          alt={feature.alt}
          width="358"
          height="358"
          loading="lazy"
          decoding="async"
        />
      </picture>

      <div class="feature-content">
        <p>{feature.text}</p>
      
  <a href={feature.href} class="btn__primary tabs__btn"
            >Learn More <span
              ><img src="/icons/arrow-right.svg" class="btn__arrow" /></span></a>
    </div>
    </div>
  ))}
</div>
</div>


<script is:inline>
  const tabs = document.querySelectorAll(".feature-btn");
  const panels = document.querySelectorAll(".feature-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const id = tab.dataset.tab;

      // Update active tab
      tabs.forEach((t) =>
        t.setAttribute("aria-selected", t === tab ? "true" : "false")
      );

      // Show correct panel
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== id;
      });
    });
  });
</script>