---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props as Props;
---

<section class="faq">
  <div class="faq__items">
    {
      items.map((item, index) => (
        <article class="faq__item">
          <button
            class="faq__question"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
          >
            <span>{item.question}</span>

            <span class="faq__icon">
              <svg class="icon-plus" width="16" height="16" viewBox="0 0 16 16">
                <path d="M7 1h2v14H7zM1 7h14v2H1z" fill="currentColor" />
              </svg>

              <svg
                class="icon-minus"
                width="16"
                height="16"
                viewBox="0 0 16 16"
              >
                <path d="M1 7h14v2H1z" fill="currentColor" />
              </svg>
            </span>
          </button>

          <div id={`faq-answer-${index}`} class="faq__answer">
            <p>{item.answer}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script is:inline>
  const accordions = document.querySelectorAll(".faq");

  accordions.forEach((accordion) => {
    const buttons = accordion.querySelectorAll(".faq__question");

    buttons.forEach((button) => {
      const panel = button.nextElementSibling;
      const item = button.closest(".faq__item");

      if (!(panel instanceof HTMLElement) || !item) return;

      // Initial state
      panel.style.overflow = "hidden";
      panel.style.maxHeight = "0px";

      button.setAttribute("aria-expanded", "false");
      item.classList.remove("is-active");

      button.addEventListener("click", () => {
        const isOpen = button.getAttribute("aria-expanded") === "true";

        // Close all items
        buttons.forEach((btn) => {
          const btnPanel = btn.nextElementSibling;
          const btnItem = btn.closest(".faq__item");

          btn.setAttribute("aria-expanded", "false");
          btnItem?.classList.remove("is-active");

          if (btnPanel instanceof HTMLElement) {
            btnPanel.style.maxHeight = "0px";
          }
        });

        // Open clicked item
        if (!isOpen) {
          button.setAttribute("aria-expanded", "true");
          item.classList.add("is-active");

          panel.style.maxHeight = panel.scrollHeight + "px";
        }
      });
    });
  });
</script>
