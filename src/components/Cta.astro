---

<section class="cta section__home" aria-labelledby="cta-heading">
  <div class="cta__inner">
    <h2 id="cta-heading">Get Free Quote.<span>No Obligations.</span></h2>
    <p class="cta__subheading">
      Fill out the form to<span>receive your free quote.</span>
    </p>
    <form>
      <div class="inputs">
        <input type="text" placeholder="Name" />
        <input type="email" placeholder="Email" />
        <input type="text" placeholder="Phone" />
      </div>
      <button type="submit" class="submit__btn"
        >Get Free Quote<span
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            shape-rendering="geometricPrecision"
            fill="currentColor"
            text-rendering="geometricPrecision"
            image-rendering="optimizeQuality"
            fill-rule="evenodd"
            clip-rule="evenodd"
            viewBox="0 0 700 243.58"
            class="btn__arrow"
          >
            <path
              fill-rule="nonzero"
              d="M561.57 0 700 120.75 559.53 243.58l-20.92-23.91 94.93-83L0 137.09v-31.75l633.55-.41-92.89-81.02z"
            ></path>
          </svg></span
        >
      </button>
    </form>
  </div>
</section>
