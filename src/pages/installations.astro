  },
  {
    question: "How much can I save with solar energy?",
    answer:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras a fermentum ante, condimentum sodales sem. Aenean lorem mi, rutrum vel velit vitae, tempus efficitur eros. Donec a dui suscipit magna pharetra fringilla eget vel nisi.",
  },
  {
    question: "How long does a solar panel installation take?",
    answer:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras a fermentum ante, condimentum sodales sem. Aenean lorem mi, rutrum vel velit vitae, tempus efficitur eros. Donec a dui suscipit magna pharetra fringilla eget vel nisi.",
  },
  {
    question: "How long do solar panels last?",
    answer:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras a fermentum ante, condimentum sodales sem. Aenean lorem mi, rutrum vel velit vitae, tempus efficitur eros. Donec a dui suscipit magna pharetra fringilla eget vel nisi.",
  },
  {
    question: "Do you offer residential and commercial solar installations?",
    answer:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras a fermentum ante, condimentum sodales sem. Aenean lorem mi, rutrum vel velit vitae, tempus efficitur eros. Donec a dui suscipit magna pharetra fringilla eget vel nisi.",
  },
